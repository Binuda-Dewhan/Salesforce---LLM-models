# ==============================================================================
# Git Ignore Configuration for Salesforce AI & LLM Integration
# ==============================================================================

# 1. Environment & Secret Credentials (Never track live credentials)
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.crt

# 2. Virtual Environments & Dependencies
venv/
.venv/
env/
.env/
node_modules/

# 3. Python Bytecode & Package Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# 4. Machine Learning Checkpoints & Training Runs
checkpoint-*/
*/checkpoint-*/
salesforce-*-lora*/
lora_salesforce_notes/
results/
runs/
wandb/
.ipynb_checkpoints/
*.zip
*.tar.gz

# 5. IDEs & Operating System Files
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak

# 6. Testing, Coverage & Logs
.coverage
coverage/
.pytest_cache/
.mypy_cache/
*.log
logs/
*.sqlite3
