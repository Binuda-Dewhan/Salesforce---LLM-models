# ==============================================================================
# Salesforce AI & LLM Integration Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Salesforce CRM Credentials
# ------------------------------------------------------------------------------
# Your Salesforce My Domain URL (e.g., https://your-domain-dev-ed.develop.my.salesforce.com)
SF_INSTANCE_URL=https://your-domain-dev-ed.develop.my.salesforce.com

# Active Salesforce Session Access Token (Obtained via Developer Console or OAuth2 Flow)
# Note: In Developer Console execute: System.debug(UserInfo.getSessionId())
SF_ACCESS_TOKEN=00DgL00000XXXXX!AQEAQ...your_session_token_here

# Salesforce User Credentials (Required for automated OAuth2 / SOAP login auto-refresh)
SALESFORCE_USERNAME=your_salesforce_email@domain.com
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_salesforce_security_token_from_email
SALESFORCE_INSTANCE_URL=https://your-domain-dev-ed.develop.my.salesforce.com
SALESFORCE_API_VERSION=v61.0

# ------------------------------------------------------------------------------
# 2. Large Language Model (LLM) API Keys
# ------------------------------------------------------------------------------
# Primary Agent Brain: Google Gemini API (Get free key from https://aistudio.google.com/)
# Free Tier Models: gemini-2.0-flash (15 RPM / 1M TPM / 1500 RPD), gemini-1.5-flash
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Secondary Agent Brain Fallback: Mistral AI (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# ------------------------------------------------------------------------------
# 3. Model Context Protocol (MCP) Configuration
# ------------------------------------------------------------------------------
USE_MCP=false
MCP_SERVER_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. Hugging Face Credentials
# ------------------------------------------------------------------------------
# Hugging Face Access Token for downloading base models (google/gemma-2b-it)
HF_TOKEN=hf_your_huggingface_token_here

# ------------------------------------------------------------------------------
# 5. API Server Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# Add your production domain when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: explicit path to the LoRA adapter directory.
# Leave blank to use auto-discovery (looks in Notebook/salesforce_notes_adapter/).
LORA_ADAPTER_PATH=

# ------------------------------------------------------------------------------
# 6. Project Metadata
# ------------------------------------------------------------------------------
CANDIDATE_ID=candidate-2
